# ============================================
# Mural de Notas com Foto - Configuracao
# ============================================

# Modo de armazenamento: "s3" (producao AWS ou LocalStack/MinIO) ou "local" (pasta local)
STORAGE_BACKEND=s3

# Bucket S3 e regiao AWS
S3_BUCKET=mural-notas-dev
AWS_REGION=us-east-1
S3_PRESIGNED_EXPIRES=3600

# Para simular S3 localmente com LocalStack ou MinIO, descomente:
S3_ENDPOINT_URL=http://localhost:4566
S3_PUBLIC_ENDPOINT_URL=http://localhost:4566
S3_AUTO_CREATE_BUCKET=true
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Banco de dados:
# Se DB_HOST ou DATABASE_URL estiverem definidos, usa PostgreSQL (RDS ou container local).
# Caso contrario, usa SQLite local (mural.db).
DB_BACKEND=sqlite
SQLITE_PATH=mural.db

# Para PostgreSQL (RDS na AWS ou container local):
# DB_BACKEND=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=mural
# DB_USER=postgres
# DB_PASS=postgres

# Limites da aplicacao
MAX_UPLOAD_MB=5
POSTS_LIMIT=30
